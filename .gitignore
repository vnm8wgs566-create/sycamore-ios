# Agent worktrees. Transient checkouts of this same repo — committing them would nest the
# repository inside itself.
.claude/worktrees/

# MCP server config — holds a Supabase personal access token inline.
# Ignored rather than checked in: the remote is public, and `git add .` would
# publish the token. If the token ever moves to ${SUPABASE_ACCESS_TOKEN}
# expansion, this line can go and the file can be shared.
.mcp.json

# Per-developer signing. Team, bundle id and entitlements for whoever is sitting at the machine,
# which is the one thing about a build that is not shared. Ignored so that building on your own
# phone is never a commit — see Config/Signing.xcconfig, and copy
# Config/Signing.local.xcconfig.example to start one.
Config/Signing.local.xcconfig

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Injected by CocoaPods / Carthage if they ever appear (they should not — no dependencies)
Pods/
Carthage/Build/
